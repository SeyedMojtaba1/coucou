# Copy this file to `.env` (git-ignored) and fill it in. Never commit real keys.
# Only read by `npm run tauri dev` (debug builds) in windows/; release builds use
# Settings → Chat provider and the Windows Credential Manager instead.

# OpenAI-compatible intermediary (e.g. AvalAI)
AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_API_KEY=

# Model id to use through the intermediary (see the provider's model list)
AVALAI_MODEL=
